  "homepage": "https://github.com/afsozer/tensip#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afsozer/tensip.git"
  },
  "bugs": {
    "url": "https://github.com/afsozer/tensip/issues"
  },
  "keywords": [
    "uyap",
